# LED eCourts gateway configuration reference.
#
# Copy to `.env` only for local development; never commit real values.
# On FastAPI Cloud, set these as app secrets/environment variables in the
# dashboard (never in source code).
#
# Firebase project (from lib/firebase_options.dart: projectId lawyer-s-e-diary)
FIREBASE_PROJECT_ID=lawyer-s-e-diary
# Service account JSON (entire contents) for Firestore Admin access.
# Obtain from Firebase Console -> Project Settings -> Service Accounts.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# eCourts provider credentials (never placed in Flutter, JURIS, logs, or tests)
# Base URL per https://ecourtsindia.com/api/docs (documented, not verified against live provider)
ECOURTS_API_KEY=replace_with_real_key
ECOURTS_BASE_URL=https://webapi.ecourtsindia.com
ECOURTS_REQUEST_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Abuse protection / rate limiting
# ---------------------------------------------------------------------------
# The values below are the documented defaults from gateway/config.py.
# Integer variables are clamped to the documented range; an out-of-range or
# unparsable value falls back to the default. These values control refresh
# request frequency only — they do not affect paid case tokens, token
# balances, pricing, purchases, or subscription entitlements.

# Per-user refresh limit: admitted refresh attempts per verified Firebase UID
# per rolling window. The next attempt beyond this limit is rejected with
# HTTP 429 and a Retry-After header. Default 5. Allowed range 1-1000.
RATE_LIMIT_USER_MAX_REQUESTS=5

# Rolling window for the per-user limit, in seconds. Default 600 (10 minutes).
# Allowed range 1-86400.
RATE_LIMIT_USER_WINDOW_SECONDS=600

# Per-case refresh limit: admitted refresh attempts per verified Firebase UID
# per case per rolling window. The next attempt beyond this limit is rejected
# with HTTP 429 and a Retry-After header. Default 5. Allowed range 1-1000.
RATE_LIMIT_CASE_MAX_REQUESTS=5

# Rolling window for the per-case limit, in seconds. Default 300 (5 minutes).
# Allowed range 1-86400.
RATE_LIMIT_CASE_WINDOW_SECONDS=300

# Global capacity multiplier: the global allowance for one accounting window
# is (estimated active users x this multiplier). This is an application-level
# safety mechanism and is NOT a verified provider quota. Default 5.
# Allowed range 1-100.
RATE_LIMIT_CAPACITY_MULTIPLIER=5

# Fallback estimate of unique active users, used only when no presence
# session data is available. The global allowance is
# (this value x RATE_LIMIT_CAPACITY_MULTIPLIER).
# IMPORTANT: leaving this at 0 means no global allowance can be established
# from presence data alone; the zero-user fallback (below) is used instead.
# Default 0. Allowed range 0-100000.
RATE_LIMIT_ESTIMATED_ACTIVE_USERS=0

# Zero-user fallback estimate: when the presence query succeeds but reports
# zero active users, this value is used as the effective active-user count.
# This prevents all refreshes from being blocked when no clients have
# registered presence sessions yet. Default 5. Allowed range 0-100000.
# Setting this to 0 causes all refreshes to fail with HTTP 503.
RATE_LIMIT_ZERO_USER_FALLBACK_USERS=5

# Lifetime of a presence session, in seconds. A session that stops sending
# heartbeats is treated as expired and is no longer counted as an active
# user. Default 300. Allowed range 30-86400.
RATE_LIMIT_PRESENCE_TTL_SECONDS=300

# Global accounting window, in seconds. The global allowance is fixed at the
# start of each window and is not increased when the active-user estimate
# changes mid-window. Default 3600 (1 hour). Allowed range 60-86400.
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600

# Lifetime of a per-case concurrency lock, in seconds. A lock left behind by
# a crashed request expires after this period. Default 30.
# Allowed range 5-3600.
RATE_LIMIT_CASE_LOCK_TTL_SECONDS=30

# Fail-closed behaviour for the rate limiters. When true, a shared-state
# failure (for example a Firestore outage) is reported as HTTP 503 and the
# request is not admitted. When false, the request is admitted without a
# limit check, which removes the protection and is not recommended.
# Default true.
RATE_LIMIT_FAIL_CLOSED=true


# ---------------------------------------------------------------------------
# Razorpay checkout (disabled until merchant onboarding and staging approval)
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=replace_with_test_or_live_key_id
RAZORPAY_KEY_SECRET=configure_in_hosting_secrets_only
RAZORPAY_WEBHOOK_SECRET=configure_in_hosting_secrets_only
